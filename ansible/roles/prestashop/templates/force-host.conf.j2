# Géré par Ansible, ne pas modifier à la main.
# L'ALB Floci réécrit Host en <private_ip>:80, ce qui fait boucler la redirection
# de PrestaShop. `early` rend le header visible aussi par mod_rewrite.
RequestHeader set Host "{{ alb_dns_name }}" early

# Les redirections générées par Apache (ex. /admin → /admin/) utilisent ce nom.
ServerName {{ alb_dns_name }}
UseCanonicalName On
