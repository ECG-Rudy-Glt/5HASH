# Géré par Ansible, ne pas modifier à la main.
services:
  prestashop:
    image: {{ prestashop_image }}
    restart: unless-stopped
    # mod_headers est requis par force-host.conf.
    command: sh -c "a2enmod headers && exec /tmp/docker_run.sh"
    ports:
      # Pas 0.0.0.0 : conflit avec le service de métadonnées de Floci sur le port 80.
      - "{{ private_ip }}:{{ prestashop_http_port }}:80"
    volumes:
      - prestashop_data:/var/www/html
      - ./force-host.conf:/etc/apache2/conf-enabled/force-host.conf:ro
    environment:
      DB_SERVER: "{{ prestashop_db_creds.host }}"
      DB_PORT: "{{ prestashop_db_creds.port }}"
      DB_NAME: "{{ prestashop_db_creds.dbname }}"
      DB_USER: "{{ prestashop_db_creds.username }}"
      DB_PASSWD: "{{ prestashop_db_creds.password }}"
      PS_INSTALL_AUTO: "1"
      PS_DOMAIN: "{{ alb_dns_name }}"
      ADMIN_MAIL: "{{ vault_ps_admin_mail }}"
      ADMIN_PASSWD: "{{ vault_ps_admin_passwd }}"
      PS_FOLDER_ADMIN: "{{ prestashop_admin_folder }}"
      PS_ERASE_DB: "0"

volumes:
  prestashop_data:
