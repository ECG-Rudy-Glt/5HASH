# Généré par Ansible à partir de ce que Terraform et Vault ont transmis —
# ne pas modifier à la main : ce fichier est réécrit à chaque passage.
services:
  prestashop:
    image: {{ prestashop_image }}
    restart: unless-stopped
    ports:
      # Lié à l'IP précise de l'instance, pas 0.0.0.0 : sur Floci, une
      # écoute large entre en conflit avec le socat de métadonnées interne
      # (169.254.169.254:80). C'est aussi l'IP que l'ALB utilise pour
      # joindre l'instance, donc rien ne change côté routage.
      - "{{ private_ip }}:{{ prestashop_http_port }}:80"
    environment:
      DB_SERVER: "{{ prestashop_db_creds.host }}"
      DB_PORT: "{{ prestashop_db_creds.port }}"
      DB_NAME: "{{ prestashop_db_creds.dbname }}"
      DB_USER: "{{ prestashop_db_creds.username }}"
      DB_PASSWD: "{{ prestashop_db_creds.password }}"
      PS_INSTALL_AUTO: "1"
      PS_DOMAIN: "{{ alb_dns_name }}"
      ADMIN_MAIL: "{{ vault_ps_admin_mail }}"
      ADMIN_PASSWD: "{{ vault_ps_admin_passwd }}"
      PS_FOLDER_ADMIN: admin
      PS_ERASE_DB: "0"
    volumes:
      - prestashop_data:/var/www/html

volumes:
  prestashop_data:
